NODE_ENV=development
PORT=4000
CLIENT_ORIGINS=http://127.0.0.1:5174
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=tamar_dev
LOG_LEVEL=info

# Keep access_token for both organizational SSO and guarded local development.
AUTH_MODE=access_token
# organizational-sso is the production/default mode. local-personal-number is development-only.
TAMAR_AUTH_MODE=organizational-sso
SSO_ISSUER=https://identity.example.invalid/
SSO_AUDIENCE=api://tamar
SSO_JWKS_URI=https://identity.example.invalid/.well-known/jwks.json
SSO_PROVIDER_KEY=organization-sso
SSO_ALLOWED_ALGORITHMS=RS256
SSO_SUBJECT_CLAIM=sub
SSO_PERSONAL_NUMBER_CLAIM=personal_number
SSO_DISPLAY_NAME_CLAIM=name
SSO_EMAIL_CLAIM=email
SSO_PERSONAL_NUMBER_PATTERN=^[\p{L}\p{N}._/-]{1,128}$
AUTH_CLOCK_TOLERANCE_SECONDS=30
AUTH_TOKEN_MAX_LENGTH=16384

# Supply from a secret manager. Use a stable random secret of at least 32 UTF-8 bytes.
IDENTITY_LOOKUP_HMAC_KEY=replace-with-a-secret-of-at-least-32-bytes

# Used only by scripts/local-auth when every development guard passes.
LOCAL_AUTH_HOST=127.0.0.1
LOCAL_AUTH_PORT=4100
LOCAL_AUTH_ISSUER=http://127.0.0.1:4100/
LOCAL_AUTH_AUDIENCE=api://tamar-local-development
LOCAL_AUTH_CLIENT_ORIGIN=http://127.0.0.1:5174
LOCAL_AUTH_TOKEN_TTL_SECONDS=900
